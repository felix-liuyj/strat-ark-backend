# StratArk 全栈编排环境变量模板（docker compose 变量替换用，复制为 .env 后填写）
# 原则：仅列密钥、外部服务地址、功能开关；有合理默认值的项以注释给出、需要覆盖时取消注释。
# 留空的外部集成会隐藏入口、返回空结果或明确失败，不制造演示数据。后端裸机部署另见 strat-ark-backend/.env.example。

# ------------------------------------------------------------
# 基础设施（base 有开发默认值；生产由 docker-compose.prod.yml 强制 :? 校验）
# ------------------------------------------------------------
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET_KEY=
ENCRYPT_KEY=
# ADMIN_EMAIL_SUFFIXES=stratark.io

# ------------------------------------------------------------
# 前端构建 / 运行时
# ------------------------------------------------------------
# 浏览器侧访问的 API 公网地址（生产必填；运行时也会经容器 env 覆写 runtime-config.js）
VITE_API_BASE_URL=
# 标题 / 路径 / 语言 / 主题有默认值，需要才覆盖：
# VITE_APP_TITLE= / VITE_BASE_PATH=/ / VITE_DEFAULT_LANG=zh / VITE_DEFAULT_THEME=dark
# OAuth 公开 client_id（public PKCE，无 secret）：留空即隐藏对应登录按钮
VITE_OAUTH_GOOGLE_CLIENT_ID=
VITE_OAUTH_MICROSOFT_CLIENT_ID=
VITE_OAUTH_REDIRECT_URI=
# VITE_OAUTH_MICROSOFT_TENANT=common

# ------------------------------------------------------------
# 后端集成（留空即未启用 / 回退）
# ------------------------------------------------------------
# SMTP：注册 / 重置密码验证码邮件（默认 465 + SSL，覆盖用 SMTP_PORT / SMTP_USE_SSL）
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
# OAuth（后端验签 / 换码；Google Web 应用即使 PKCE 也需 secret）
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
# OAUTH_MICROSOFT_TENANT=common
# Stripe 订阅支付（启用收费时两项必填；Webhook 指向 {后端域名}/webhooks/stripe）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Checkout / Portal 回跳基址，留空取首个 CORS origin
FRONTEND_BASE_URL=
# 阿里云 OSS（文件上传 / 邮件 logo）
ALI_OSS_ACCESS_KEY=
ALI_OSS_ACCESS_SECRET=
ALI_OSS_REGION=
ALI_OSS_BUCKET_NAME=
BRAND_LOGO_OSS_PATH=
# AI 投研 LLM 网关不走 env：由管理员在引擎管理页配置（tradingagents 连接配置，
# 落库为单一事实源）；未配置时 AI 投研接口返回明确错误
# 行情 / 交易所 REST 默认 Binance 公共端点，自建代理时覆盖：
# MARKET_DATA_REST_URL= / MARKET_DATA_WS_URL= / MARKET_DATA_API_KEY= / EXCHANGE_API_BASE=

# ------------------------------------------------------------
# 生产引擎 / TradingAgents（docker-compose.prod.yml + engines.yml）
# ------------------------------------------------------------
# Freqtrade 编排器控制面令牌（必填；引擎管理页连接配置中填同一值）
ORCHESTRATOR_TOKEN=
LLM_API_KEY=
# LLM_GATEWAY_URL= / LLM_DEFAULT_MODEL=claude-sonnet
# FREQTRADE_IMAGE= / TRADINGAGENTS_API_IMAGE= / FREQTRADE_STRATEGY=
