# ============================================================
# 后端脚手架环境变量配置示例
# 复制此文件为 .env 并填写实际值
# ============================================================

# ------------------------------------------------------------
# 应用基础配置
# ------------------------------------------------------------
APP_NAME=Backend Scaffold API
APP_NO=strat-ark-backend
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# 前端域名
FRONTEND_DOMAIN=http://localhost:3000

# CORS 允许的源（多个用逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------
# 数据库配置
# 仅支持 PostgreSQL，驱动固定为 postgresql+psycopg://
# ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/strat_ark
DATABASE_SCHEMA=public

# ------------------------------------------------------------
# Redis 配置
# ------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_SSL=false

# ------------------------------------------------------------
# JWT 配置
# ------------------------------------------------------------
JWT_SECRET_KEY=replace-with-a-secure-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7
JWT_REFRESH_EXPIRE_DAYS=30
# 管理员邮箱后缀，多个用逗号分隔，例如 example.com,admin.example.com
ADMIN_EMAIL_SUFFIXES=

# ------------------------------------------------------------
# 阿里云 OSS 配置（ACCESS_KEY/SECRET 建议由运行环境注入，不提交至版本库）
# ALI_OSS_REGION 支持 `cn-shanghai`、`oss-cn-shanghai` 或完整 endpoint
# ------------------------------------------------------------
ALI_OSS_ACCESS_KEY=
ALI_OSS_ACCESS_SECRET=
ALI_OSS_REGION=
ALI_OSS_BUCKET_NAME=
# 邮件 logo 在 OSS 中的 object key（留空则验证码邮件不显示 logo）
BRAND_LOGO_OSS_PATH=

# ------------------------------------------------------------
# SMTP 邮件配置
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_USE_SSL=true

# ------------------------------------------------------------
# 外部集成（当前为 libs/integrations/* stub，留空即用拟真 mock 数据，不影响运行）
# 真实接入时填写以下各项
# ------------------------------------------------------------
ENCRYPT_KEY=
FREQTRADE_ORCHESTRATOR_URL=
FREQTRADE_API_TOKEN=
TRADINGAGENTS_API_URL=
LLM_GATEWAY_URL=
LLM_API_KEY=
LLM_DEFAULT_MODEL=claude-sonnet
MARKET_DATA_WS_URL=
MARKET_DATA_API_KEY=
K8S_NAMESPACE=stratark-prod
K8S_IN_CLUSTER=false
TELEGRAM_BOT_TOKEN=
SLACK_WEBHOOK_URL=
LARK_WEBHOOK_URL=

# ------------------------------------------------------------
# 静态资源配置
# ------------------------------------------------------------
STATIC_DIR=./statics
STATIC_URL=/statics
