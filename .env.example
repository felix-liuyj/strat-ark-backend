# ============================================================
# Strat Ark 后端环境变量配置示例（裸机 / 本地运行：复制为 .env 并填写）
# 原则：仅列密钥、外部服务地址、功能开关；有合理代码默认值的项以注释给出、
# 需要覆盖时取消注释即可（应用内部常量不在此列，见 configs/settings.py）。
# Docker 编排路径见仓库根目录 .env.example。
# ============================================================

# ------------------------------------------------------------
# 应用运行配置
# ------------------------------------------------------------
APP_ENV=local
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------
# 数据库 / Redis
# 数据库仅支持 PostgreSQL，驱动固定为 postgresql+psycopg://
# ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/strat_ark
# DATABASE_SCHEMA=public
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------
# JWT 会话
# access 短 TTL（分钟，前端 silent refresh）+ refresh 长 TTL（jti 白名单可吊销），
# TTL 默认 15 分钟 / 30 天，特殊需要才覆盖：JWT_ACCESS_EXPIRE_MINUTES / JWT_REFRESH_EXPIRE_DAYS
# ------------------------------------------------------------
JWT_SECRET_KEY=replace-with-a-secure-secret
# 管理员邮箱后缀，多个用逗号分隔，例如 example.com,admin.example.com
ADMIN_EMAIL_SUFFIXES=

# ------------------------------------------------------------
# OAuth 登录（留空即隐藏对应登录入口；前端也需配置同一个 client id）
# client_secret 仅在 IdP 注册为 Web（机密）客户端时填写（Google Web 应用即使 PKCE 也要求）；
# 注册为纯 public/SPA 客户端则留空（仅 PKCE）。只在后端持有，绝不下发前端。
# ------------------------------------------------------------
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
# OAUTH_MICROSOFT_TENANT=common

# ------------------------------------------------------------
# 业务敏感数据加密（交易所 / 网关 API Key 入库加密；生产必须注入强随机值）
# ------------------------------------------------------------
ENCRYPT_KEY=

# ------------------------------------------------------------
# 阿里云 OSS（文件上传 / 邮件 logo；留空即未启用）
# ALI_OSS_REGION 支持 `cn-shanghai`、`oss-cn-shanghai` 或完整 endpoint
# ------------------------------------------------------------
ALI_OSS_ACCESS_KEY=
ALI_OSS_ACCESS_SECRET=
ALI_OSS_REGION=
ALI_OSS_BUCKET_NAME=
BRAND_LOGO_OSS_PATH=

# ------------------------------------------------------------
# SMTP 邮件（注册 / 重置密码验证码；留空时发码接口返回明确错误）
# 默认 465 + SSL，特殊网关才覆盖：SMTP_PORT / SMTP_USE_SSL
# ------------------------------------------------------------
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=

# ------------------------------------------------------------
# 行情数据源（默认 Binance 公共 REST，无需密钥；请求失败自动回退确定性数据）
# 区域封锁时覆盖为自建代理：MARKET_DATA_REST_URL=https://api.binance.com
# ------------------------------------------------------------
# MARKET_DATA_WS_URL=
# MARKET_DATA_API_KEY=

# ------------------------------------------------------------
# AI 投研 LLM 网关不走 env：由管理员在引擎管理页配置（tradingagents 连接配置：
# provider / 端点 / 模型 / apiKey，落库为单一事实源）；未配置即回退确定性拟真研报。
# ------------------------------------------------------------

# ------------------------------------------------------------
# 交易所私有 REST（账户余额 / 权限查询，非下单；默认 Binance 现货 REST）
# 自建代理时覆盖：EXCHANGE_API_BASE=https://api.binance.com
# 引擎运行时（freqtrade / tradingagents）地址存于引擎配置页 connection_config.serviceUrl，不走 env。
# ------------------------------------------------------------

# ------------------------------------------------------------
# Stripe 支付（订阅 Checkout + Customer Portal + Webhook；留空即未启用、订阅走本地模拟）
# 套餐元数据与 Stripe 产品 / 价格 ID 落库(plans 表)，由后台「同步到 Stripe」回填。
# Webhook 在 Stripe 控制台注册指向 {域名}/webhooks/stripe，密钥填 STRIPE_WEBHOOK_SECRET。
# ------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Checkout / Portal 回跳基址，留空取首个 CORS origin
FRONTEND_BASE_URL=
