# ============================================================
# Strat Ark 后端环境变量配置示例
# 复制此文件为 .env 并填写实际值
# ============================================================

# ------------------------------------------------------------
# 应用运行配置
# ------------------------------------------------------------
APP_NAME=Strat Ark Backend API
APP_NO=strat-ark-backend
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ------------------------------------------------------------
# Web 跨域配置
# ------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------
# 数据库配置
# 仅支持 PostgreSQL，驱动固定为 postgresql+psycopg://
# ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/strat_ark
DATABASE_SCHEMA=public

# ------------------------------------------------------------
# Redis 配置
# ------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_SSL=false

# ------------------------------------------------------------
# JWT 配置
# ------------------------------------------------------------
JWT_SECRET_KEY=replace-with-a-secure-secret
JWT_ALGORITHM=HS256
# access 短 TTL（分钟，前端 silent refresh）；refresh 长 TTL + jti 白名单可吊销
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30
# 管理员邮箱后缀，多个用逗号分隔，例如 example.com,admin.example.com
ADMIN_EMAIL_SUFFIXES=

# ------------------------------------------------------------
# OAuth 登录配置
# Public PKCE + 后端 exchange；前端也需要配置同一个 client id
# ------------------------------------------------------------
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_TENANT=common
OAUTH_TOKEN_TIMEOUT_SECONDS=10
# client_secret 仅在 IdP 注册为 Web（机密）客户端时填写（Google Web 应用即使 PKCE 也要求）；
# 注册为纯 public/SPA 客户端则留空（仅 PKCE）。只在后端持有，绝不下发前端。
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_SECRET=

# ------------------------------------------------------------
# 业务敏感数据加密配置
# 交易所 / 网关 API Key 入库加密使用；生产必须由运行环境注入强随机值
# ------------------------------------------------------------
ENCRYPT_KEY=

# ------------------------------------------------------------
# 阿里云 OSS 配置
# ACCESS_KEY/SECRET 建议由运行环境注入，不提交至版本库
# ALI_OSS_REGION 支持 `cn-shanghai`、`oss-cn-shanghai` 或完整 endpoint
# ------------------------------------------------------------
ALI_OSS_ACCESS_KEY=
ALI_OSS_ACCESS_SECRET=
ALI_OSS_REGION=
ALI_OSS_BUCKET_NAME=
BRAND_LOGO_OSS_PATH=

# ------------------------------------------------------------
# SMTP 邮件配置
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_USE_SSL=true

# ------------------------------------------------------------
# 行情数据源
# REST 行情默认对接 Binance 公共接口（无需密钥）；请求失败自动回退确定性数据。
# MARKET_DATA_REST_URL 可覆盖为自建代理 / 镜像（区域封锁时）。WS 为未来实时推送预留。
# ------------------------------------------------------------
MARKET_DATA_REST_URL=https://api.binance.com
MARKET_DATA_WS_URL=
MARKET_DATA_API_KEY=

# ------------------------------------------------------------
# AI 投研 LLM 网关（TradingAgents 多智能体研报；provider-neutral）
# 留空 AI_GATEWAY_API_KEY 即回退确定性拟真研报，不发起任何 LLM 请求。
# provider=anthropic 走 Messages API（默认 https://api.anthropic.com，模型默认 claude-opus-4-8）；
# provider=openai 走 OpenAI 兼容 chat/completions 网关。AI 仅辅助决策，绝不直接下单。
# ------------------------------------------------------------
AI_GATEWAY_PROVIDER=anthropic
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=claude-opus-4-8

# ------------------------------------------------------------
# 交易所私有 REST（账户余额 / 权限查询，非下单）
# 默认 Binance 现货 REST。真实联通需 view_model 提供可用的明文 api_key + api_secret
# （HMAC-SHA256 签名 + X-MBX-APIKEY 头）；当前密钥入库为占位密文、不可逆，故实际走回退。
# 待加密落地（KMS/fernet 还原明文 secret）后，新增凭证或未保存连接测试即可真实联通。
# ------------------------------------------------------------
EXCHANGE_API_BASE=https://api.binance.com

# ------------------------------------------------------------
# 引擎运行时（freqtrade / tradingagents）
# 不做 K8s 集群化；backend 经引擎暴露的 HTTP API 做服务连接交互。各引擎服务地址存于
# 其 connection_config.serviceUrl（引擎配置页 UI 管理），故此处无 env；不可达即回退示意数据。
# ------------------------------------------------------------

# ------------------------------------------------------------
# Stripe 支付（订阅 Checkout + Customer Portal + Webhook）
# 仅密钥类走 env；套餐元数据与 Stripe 产品 / 价格 ID 落库(plans 表)，由后台「同步到 Stripe」回填。
# STRIPE_SECRET_KEY 必填（拉起支付）；Webhook 在 Stripe 控制台注册指向 {域名}/webhooks/stripe，
# 密钥填 STRIPE_WEBHOOK_SECRET。FRONTEND_BASE_URL 留空则取首个 CORS origin（Checkout/Portal 返回地址）。
# ------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_BASE_URL=

# ------------------------------------------------------------
# 静态资源配置
# ------------------------------------------------------------
STATIC_DIR=./statics
STATIC_URL=/statics
